# Data files — snapshots are ingested from source URLs, not committed.
# Crosswalks (data/crosswalks/) are the exception; they're version-controlled.
data/raw/
data/curated/
data/quarantine/
data/warehouse/

# dbt build artifacts — regenerated from models on every `dbt build`.
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
uv.lock

# Jupyter
.ipynb_checkpoints/

# Secrets — HUD API token etc. Never commit.
.env
.env.*
!.env.example
